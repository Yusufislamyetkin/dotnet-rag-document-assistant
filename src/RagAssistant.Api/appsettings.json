{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=ragassistant;Username=rag;Password=rag"
  },
  "Jwt": {
    "Issuer": "rag-document-assistant",
    "Audience": "rag-document-assistant",
    "SigningKey": "",
    "ExpiryMinutes": 120
  },
  "Database": { "MigrateOnStartup": true },
  "RateLimiting": { "ChatPerMinute": 20, "UploadPerMinute": 10, "AuthPerMinute": 10 },
  "Cors": { "Origins": [ "http://localhost:5173", "http://localhost:8080" ] },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
