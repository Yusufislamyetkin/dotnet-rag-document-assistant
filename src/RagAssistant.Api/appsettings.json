{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=ragassistant;Username=rag;Password=rag"
  },
  "Jwt": {
    "Issuer": "rag-document-assistant",
    "Audience": "rag-document-assistant",
    "SigningKey": "",
    "ExpiryMinutes": 120
  },
  "Llm": {
    "Provider": "Auto",
    "Anthropic": { "Model": "claude-sonnet-5-5" },
    "OpenAI": { "ChatModel": "gpt-4.1-mini" }
  },
  "Embeddings": {
    "Provider": "Auto",
    "OpenAI": { "Model": "text-embedding-3-small" }
  },
  "Ingestion": {
    "MaxFileBytes": 20971520,
    "MaxFilesPerUpload": 10,
    "ChunkTokens": 800,
    "ChunkOverlapTokens": 100,
    "EmbeddingBatchSize": 64
  },
  "Retrieval": {
    "TopK": 6,
    "CandidatePoolSize": 30,
    "RrfK": 60,
    "MinVectorSimilarity": 0.25
  },
  "Chat": {
    "MaxQuestionChars": 2000,
    "HistoryMessages": 6,
    "MaxAnswerTokens": 1500
  },
  "Pricing": {
    "Models": {
      "claude-sonnet-5-5": { "InputPerMillion": 2.00, "OutputPerMillion": 10.00 },
      "claude-haiku-5-5": { "InputPerMillion": 0.10, "OutputPerMillion": 0.50 },
      "claude-opus-5-5": { "InputPerMillion": 4.00, "OutputPerMillion": 20.00 },
      "gpt-4.1-mini": { "InputPerMillion": 0.40, "OutputPerMillion": 1.60 },
      "text-embedding-3-small": { "InputPerMillion": 0.02, "OutputPerMillion": 0 }
    }
  },
  "Storage": { "Root": "data/uploads" },
  "Demo": { "SeedSamples": false, "SamplesPath": "samples" },
  "Database": { "MigrateOnStartup": true },
  "RateLimiting": { "ChatPerMinute": 20, "UploadPerMinute": 10, "AuthPerMinute": 10 },
  "Cors": { "Origins": [ "http://localhost:5173", "http://localhost:8080" ] },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
