# Copy to .env and fill in what you need. Every value is optional:
# with no API keys the app runs in demo mode (mock LLM + hashed embeddings + seeded sample PDFs).

# LLM provider: Auto | Anthropic | OpenAI | Mock  (Auto = Anthropic if its key is set, else OpenAI, else Mock)
LLM_PROVIDER=Auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Embeddings provider: Auto | OpenAI | Mock  (Auto = OpenAI if OPENAI_API_KEY is set, else Mock)
EMBEDDINGS_PROVIDER=Auto

# Security: change for anything that is not a local demo (min 32 chars)
JWT_SIGNING_KEY=local-demo-signing-key-change-me-0123456789
POSTGRES_PASSWORD=rag

# Ports on the host
POSTGRES_PORT=5433
API_PORT=5080
WEB_PORT=8080

# Seed the PDFs in samples/ for the demo user on first start
DEMO_SEED_SAMPLES=true

# Optional OpenTelemetry collector (e.g. http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=
